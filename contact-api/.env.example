# Server-side secrets for the contact function.
# Set these in the Vercel project (Settings -> Environment Variables).
# NEVER put these in the static site build / GitHub repo secrets.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Sender address. Use a verified-domain address for production, or leave the
# resend.dev sandbox below. NOTE: the sandbox only delivers to your own Resend
# account email, so in sandbox mode ADMIN_NOTIFICATION_EMAIL must be that email.
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Where contact submissions are emailed (admin-notify only).
ADMIN_NOTIFICATION_EMAIL=

# reCAPTCHA v3 secret key (pairs with NEXT_PUBLIC_RECAPTCHA_SITE_KEY on the site)
RECAPTCHA_SECRET_KEY=

# Minimum reCAPTCHA score to accept (0.0-1.0). Optional, default 0.5.
RECAPTCHA_MIN_SCORE=0.5

# Comma-separated browser origins allowed to POST (the live site + local dev).
ALLOWED_ORIGIN=https://ehgp.github.io
