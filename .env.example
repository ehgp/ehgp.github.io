# Client (public) env — baked into the static GitHub Pages build.
# Set these as GitHub repo secrets for the next-static-export workflow.

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
NEXT_PUBLIC_GTM_ID=

# Google AdSense client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX).
NEXT_PUBLIC_ADSENSE_CLIENT=
