# Client (public) env — baked into the static GitHub Pages build.
# Set these as GitHub repo secrets for the next-static-export workflow.
# Server-side email/reCAPTCHA secrets live in contact-api/.env.example instead.

# reCAPTCHA v3 SITE key (public). Pairs with RECAPTCHA_SECRET_KEY on the server.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# URL of the deployed contact function (the contact-api Vercel project),
# e.g. https://ehgp-contact-api.vercel.app/api/contact
NEXT_PUBLIC_CONTACT_ENDPOINT=
